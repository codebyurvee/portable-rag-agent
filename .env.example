# ── Portable RAG Agent — Environment Variables ──
# Copy this file to `.env` and fill in your values.

# --- LLM / Model provider ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Default model to use for the agent
LLM_MODEL=gpt-4o-mini

# --- Embeddings ---
EMBEDDING_MODEL=text-embedding-3-small

# --- Framework selection (langgraph | llamaindex) ---
AGENT_FRAMEWORK=langgraph

# --- Vector store / database ---
# e.g. sqlite, chroma, pgvector connection string
DATABASE_URL=sqlite:///database/rag.db
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=database/chroma

# --- Document ingestion ---
DOCUMENTS_DIR=documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Logging ---
LOG_LEVEL=INFO
