# ── Portable RAG Agent — Environment Variables ──
# Copy this file to `.env` and fill in your values. Never commit `.env`.

# --- LLM / Model provider (Qwen3-8B via an OpenAI-compatible endpoint) ---
QWEN_API_KEY=
QWEN_BASE_URL=https://router.huggingface.co/v1
QWEN_MODEL=Qwen/Qwen3-8B

# --- Web search (optional; tool is disabled if unset) ---
WEB_SEARCH_API_KEY=

# --- Embeddings ---
# Local ONNX model — no API key required.
# FASTEMBED_CACHE_PATH must match the path baked into the Docker image.
# Leave unset for local development (fastembed uses its own default cache).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
FASTEMBED_CACHE_PATH=

# --- Vector store (Qdrant) ---
# Leave QDRANT_URL empty to use local in-memory Qdrant (dev/tests only — not persistent).
# For production, use a Qdrant Cloud cluster URL and API key.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=documents

# --- SQLite persistence (query/run metadata) ---
# Default path is relative to the working directory.
# On Render without a persistent disk, use /tmp/agent.db (data is lost on restart).
DATABASE_PATH=database/agent.db

# --- Document ingestion ---
DOCUMENTS_DIR=documents
UPLOAD_DIR=documents/uploads
MAX_UPLOAD_BYTES=10485760

# --- Streamlit UI -> API connection ---
# For local development: http://localhost:8000
# For Render: set to the deployed API service URL, e.g. https://<api-service>.onrender.com
API_BASE_URL=http://localhost:8000
